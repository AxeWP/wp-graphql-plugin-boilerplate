# https://phpstan.org/config-reference

parameters:
	# Rules
	treatPhpDocTypesAsCertain: false
	inferPrivatePropertyTypeFromConstructor: true
	checkExplicitMixedMissingReturn: true
	checkFunctionNameCase: true
	checkInternalClassCaseSensitivity: true
	checkTooWideReturnTypesInProtectedAndPublicMethods: true
	polluteScopeWithAlwaysIterableForeach: false
	polluteScopeWithLoopInitialAssignments: false
	reportAlwaysTrueInLastCondition: true
	reportStaticMethodSignatures: true
	reportWrongPhpDocTypeInVarTag: true

	# Configuration
	level: 8
	# Site owners can define these before the plugin loads, so their values are not fixed.
	dynamicConstantNames:
		- WPGRAPHQL_PB_AUTOLOAD

	tmpDir: tests/_output
	phpVersion:
		min: 70400
		max: 80500
	stubFiles:
		- phpstan/class-wp-post-type.stub
		- phpstan/class-wp-taxonomy.stub
	bootstrapFiles:
		- phpstan/constants.php
		- wp-graphql-plugin-name.php
		- access-functions.php
		- activation.php
		- deactivation.php
	paths:
		- wp-graphql-plugin-name.php
		- access-functions.php
		- activation.php
		- deactivation.php
		- src/
	excludePaths:
		analyse:
			- tests/
			- vendor/
			- vendor-prefixed (?)
		analyseAndScan:
			- node_modules (?)
	scanFiles:
		- vendor/axepress/wp-graphql-stubs/wp-graphql-stubs.php
	scanDirectories:
		- src/
		- vendor-prefixed/axepress/wp-graphql-plugin-boilerplate/src/
